// Starting data for every new profile (db/seeds.rb, POST /profiles) and the keyword lists that
// Keywords::TypeInference uses to tell debits from credits. This file is committed and the repo
// is public: keep it generic. No personal names, CPFs/CNPJs, PIX keys or local businesses.
//
// categories[].subcategories[].type is one of gain, expense, investment, transfer, other.
{
  "categories": [
    {
      "name": "Ganhos",
      "color_code": "#D4EFDF",
      "subcategories": [
        { "name": "SALARIO", "type": "gain", "color_code": "#A9DFBF", "keywords": ["SALARIO", "LIBERACAO_CAMBIO"] },
        { "name": "TRANSFERENCIAS", "type": "transfer", "color_code": "#7DCEA0", "keywords": ["TRANSFERENCIA_DA_POUPANCA"] },
